  "icons": [
    {
      "src": "/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Invoice Maker",
      "short_name": "Invoices",
      "url": "/invoices"
    },
    {
      "name": "Resume Builder",
      "short_name": "Resumes",
      "url": "/resumes"
    },
    {
      "name": "Invitation Maker",
      "short_name": "Invitations",
      "url": "/invitations"
    }
  ]
}
